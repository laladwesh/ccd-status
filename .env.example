# Copy to .env and fill in. NEVER commit .env.
# Values containing "$" (the bcrypt hash) MUST be wrapped in single quotes.

# ---- Status database (own MongoDB container; NOT the portals' database) ----
# Use letters and digits only (no @ : / ? #) because these go into a connection URL.
MONGO_USER=ccdstatus
MONGO_PASSWORD=change-me-to-a-long-random-alphanumeric-string

# ---- Admin login (single admin user) ----
ADMIN_USERNAME=admin
# Generate: cd server && npm install && npm run hash-password -- 'your-long-password'
ADMIN_PASSWORD_HASH='$2a$12$replace-with-the-generated-hash'
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-32-or-more-random-characters

# ---- API ----
# Extra browser origins allowed to call the API (same-origin needs nothing). Comma separated.
CORS_ORIGINS=

# ---- Checker ----
CHECK_INTERVAL_SEC=60
PROBE_TIMEOUT_MS=10000
SLOW_MS=2000
MAX_CONCURRENT_PROBES=5
TZ=Asia/Kolkata

# ---- Alerts: ALL OFF by default. The dashboard works fully without them. ----
ALERT_COOLDOWN_MIN=10

# Email (use a non-IITG SMTP, e.g. Gmail with an App Password: IITG mail may be down in the same outage)
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Telegram bot (create with @BotFather, then message the bot and get your chat id)
ALERT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
